// NORSUCLINIC Database Schema
// Generated for dbdiagram.io
// Updated: November 26, 2025
// This represents the ACTIVE relational model of the NORSUCLINIC system
// All deprecated and unused tables have been removed

Project NORSUCLINIC {
  database_type: 'MySQL'
  Note: 'Comprehensive Hospital/Clinic Management System Database Schema - Active Tables Only'
}

// ==========================================
// CORE USER MANAGEMENT TABLES
// ==========================================

Table users {
  id bigint [pk, increment]
  first_name varchar(255)
  middle_name varchar(255) [null]
  last_name varchar(255)
  email varchar(191) [unique, null]
  contact varchar(255) [null]
  emergency_contact_name varchar(255) [null]
  emergency_contact_no varchar(255) [null]
  emergency_relationship varchar(255) [null]
  dob date [null]
  gender int [null]
  status boolean [default: 1]
  language varchar(255) [default: 'en', null]
  email_verified_at timestamp [null]
  password varchar(255) [null]
  type int [null]
  blood_type varchar(255) [null]
  country_code varchar(255) [null]
  campus_id int [ref: > campuses.id, null]
  college_id int [ref: > colleges.id, null]
  course_id int [ref: > courses.id, null]
  year_level_id int [ref: > year_levels.id, null]
  department_id int [ref: > departments.id, null]
  office_id int [ref: > offices.id, null]
  vaccination_id int [ref: > vaccinations.id, null]
  remember_token varchar(100) [null]
  created_at timestamp
  updated_at timestamp
  
  Note: 'Central user table for all system users (doctors, patients, staff)'
}

Table doctors {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id]
  experience double [null]
  created_at timestamp
  updated_at timestamp
  
  Note: 'Doctor-specific information linked to users table'
}

Table patients {
  id int [pk, increment]
  patient_unique_id varchar(191) [unique]
  user_id bigint [ref: > users.id]
  created_at timestamp
  updated_at timestamp
  
  Note: 'Patient-specific information with unique patient ID'
}

// ==========================================
// EDUCATIONAL INSTITUTION TABLES
// ==========================================

Table campuses {
  id bigint [pk, increment]
  campus_name varchar(255)
  created_at timestamp
  updated_at timestamp
  
  Note: 'Campus/branch locations'
}

Table colleges {
  id bigint [pk, increment]
  college_name varchar(255)
  created_at timestamp
  updated_at timestamp
  
  Note: 'Colleges within the institution'
}

Table courses {
  id bigint [pk, increment]
  course_name varchar(255)
  created_at timestamp
  updated_at timestamp
  
  Note: 'Academic courses/programs'
}

Table year_levels {
  id bigint [pk, increment]
  year_level_name varchar(255)
  created_at timestamp
  updated_at timestamp
  
  Note: 'Academic year levels (1st year, 2nd year, etc.)'
}

Table vaccinations {
  id bigint [pk, increment]
  vaccination_status varchar(255) [null]
  created_at timestamp
  updated_at timestamp
  
  Note: 'COVID vaccination status tracking'
}

Table departments {
  id bigint [pk, increment]
  name varchar(255)
  created_at timestamp
  updated_at timestamp
  
  Note: 'Academic/Medical departments'
}

Table offices {
  id bigint [pk, increment]
  name varchar(255)
  created_at timestamp
  updated_at timestamp
  
  Note: 'Administrative offices'
}

// ==========================================
// MEDICAL SERVICES & SPECIALIZATIONS
// ==========================================

Table service_categories {
  id bigint [pk, increment]
  name varchar(255)
  created_at timestamp
  updated_at timestamp
  
  Note: 'Categories for medical services'
}

Table services {
  id bigint [pk, increment]
  category_id bigint [ref: > service_categories.id]
  name varchar(255)
  charges double [null]
  status boolean [default: 1]
  created_at timestamp
  updated_at timestamp
  
  Note: 'Medical services offered by the clinic'
}

Table specializations {
  id bigint [pk, increment]
  name varchar(255)
  created_at timestamp
  updated_at timestamp
  
  Note: 'Medical specializations (Cardiology, Neurology, etc.)'
}

// ==========================================
// APPOINTMENTS & SCHEDULING
// ==========================================

Table appointments {
  id bigint [pk, increment]
  doctor_id bigint [ref: > doctors.id]
  patient_id int [ref: > patients.id]
  date varchar(255)
  from_time varchar(255)
  from_time_type varchar(255)
  to_time varchar(255)
  to_time_type varchar(255)
  status boolean [default: 1]
  description text [null]
  service_id bigint [ref: > services.id]
  payable_amount varchar(255)
  appointment_unique_id varchar(255)
  payment_type int [null]
  payment_method int [null]
  created_at timestamp
  updated_at timestamp
  
  Note: 'Patient appointment bookings with payment tracking'
}

Table doctor_sessions {
  id bigint [pk, increment]
  doctor_id bigint [ref: > doctors.id]
  available_on varchar(255)
  available_from varchar(255)
  available_to varchar(255)
  session_meeting_time varchar(255)
  created_at timestamp
  updated_at timestamp
  
  Note: 'Doctor availability schedules'
}

Table holidays {
  id bigint [pk, increment]
  name varchar(255)
  date date
  created_at timestamp
  updated_at timestamp
  
  Note: 'Holiday calendar for clinic closures'
}

Table patient_queues {
  id bigint [pk, increment]
  patient_id int [ref: > patients.id]
  queue_number int
  status varchar(255)
  called_at timestamp [null]
  completed_at timestamp [null]
  created_at timestamp
  updated_at timestamp
  
  Note: 'Patient queue management system'
}

// ==========================================
// PRESCRIPTIONS & MEDICAL RECORDS
// ==========================================

Table prescriptions {
  id bigint [pk, increment]
  appointment_id bigint [ref: > appointments.id]
  patient_id int [ref: > patients.id]
  doctor_id bigint [ref: > doctors.id, null]
  food_allergies varchar(255) [null]
  tendency_bleed varchar(255) [null]
  heart_disease varchar(255) [null]
  high_blood_pressure varchar(255) [null]
  diabetic varchar(255) [null]
  surgery varchar(255) [null]
  accident varchar(255) [null]
  others varchar(255) [null]
  medical_history varchar(255) [null]
  current_medication varchar(255) [null]
  female_pregnancy varchar(255) [null]
  breast_feeding varchar(255) [null]
  health_insurance varchar(255) [null]
  low_income varchar(255) [null]
  reference varchar(255) [null]
  status boolean [null]
  plus_rate varchar(100) [null]
  temperature varchar(100) [null]
  problem_description varchar(100) [null]
  test varchar(100) [null]
  advice varchar(100) [null]
  created_at timestamp
  updated_at timestamp
  
  Note: 'Medical prescriptions and patient health information'
}

Table prescriptions_medicines {
  id bigint [pk, increment]
  prescription_id bigint [ref: > prescriptions.id]
  medicine_id bigint [ref: > medicines.id]
  dosage varchar(255) [null]
  day varchar(255) [null]
  time varchar(255) [null]
  meal varchar(255) [null]
  created_at timestamp
  updated_at timestamp
  
  Note: 'Medicines prescribed in prescriptions'
}

Table diagnoses {
  id bigint [pk, increment]
  diagnoses varchar(255) [unique]
  created_at timestamp
  updated_at timestamp
  
  Note: 'Medical diagnoses reference table'
}

// ==========================================
// DOCUMENT MANAGEMENT
// ==========================================

Table request_documents {
  id bigint [pk, increment]
  document_creator_id bigint
  user_id bigint [ref: > users.id]
  name varchar(255)
  age int
  gender varchar(255)
  status varchar(255) [null]
  date_of_birth date [null]
  address varchar(255)
  religion varchar(255) [null]
  patient_contact varchar(255) [null]
  campus varchar(255) [null]
  college varchar(255) [null]
  course varchar(255) [null]
  year_level varchar(255) [null]
  informant varchar(255) [null]
  emergency_contact varchar(255) [null]
  requested_at date [null]
  complaints text [null]
  covid_vaccination varchar(255) [null]
  comorbidities varchar(255) [null]
  allergies varchar(255) [null]
  admissions_surgeries varchar(255) [null]
  maintenance varchar(255) [null]
  pregnancy_status varchar(255) [null]
  lmp_aog varchar(255) [null]
  vital_signs_bp varchar(255) [null]
  vital_signs_pr varchar(255) [null]
  vital_signs_temp varchar(255) [null]
  vital_signs_rr varchar(255) [null]
  vital_signs_o2_sat varchar(255) [null]
  vital_signs_height varchar(255) [null]
  vital_signs_weight varchar(255) [null]
  pertinent_exam text [null]
  assessment text [null]
  plan text [null]
  document_type varchar(255)
  consult_mode varchar(255) [null]
  nursing_intervention varchar(255) [null]
  nursing_incharged_id varchar(255) [null]
  examined_on datetime [null]
  request_of varchar(255) [null]
  complaints_diagnosis text [null]
  medical_cert_remarks text [null]
  doc_lic_no varchar(255) [null]
  doc_prt_no varchar(255) [null]
  consultation_images text [null]
  note text [null]
  created_at timestamp
  updated_at timestamp
  
  Note: 'Medical certificates, consultations, and document requests'
}

// ==========================================
// PHARMACY & MEDICINE MANAGEMENT
// ==========================================

Table categories {
  id bigint [pk, increment]
  name varchar(255)
  created_at timestamp
  updated_at timestamp
  
  Note: 'Medicine categories'
}

Table brands {
  id bigint [pk, increment]
  name varchar(255)
  created_at timestamp
  updated_at timestamp
  
  Note: 'Medicine brands/manufacturers'
}

Table medicines {
  id bigint [pk, increment]
  category_id bigint [ref: > categories.id, null]
  brand_id bigint [ref: > brands.id, null]
  name varchar(255)
  selling_price double
  buying_price double
  quantity int
  available_quantity int
  salt_composition varchar(255)
  description text [null]
  side_effects text [null]
  currency_symbol varchar(100) [null]
  stock_alert_enabled boolean [default: 0]
  minimum_stock_level int [null]
  created_at timestamp
  updated_at timestamp
  
  Note: 'Medicine inventory and details with stock alerts'
}

Table purchased_medicines {
  id bigint [pk, increment]
  purchase_id bigint [ref: > purchase_medicines.id]
  medicine_id bigint [ref: > medicines.id]
  quantity int
  expiry_date varchar(255) [null]
  manufacturing_date date [null]
  dosage varchar(255) [null]
  created_at timestamp
  updated_at timestamp
  
  Note: 'Individual medicine batches from purchases with expiry tracking'
}

Table purchase_medicines {
  id bigint [pk, increment]
  purchase_no varchar(255)
  purchase_date date
  total double
  note text [null]
  created_at timestamp
  updated_at timestamp
  
  Note: 'Purchase orders for medicine inventory'
}

Table consultation_medicines {
  id bigint [pk, increment]
  request_document_id bigint [ref: > request_documents.id]
  medicine_id bigint [ref: > medicines.id]
  quantity int
  dosage varchar(255) [null]
  created_at timestamp
  updated_at timestamp
  
  Note: 'Medicines dispensed during consultations'
}

Table sale_medicines {
  id bigint [pk, increment]
  medicine_bill_id bigint [ref: > medicine_bills.id]
  medicine_id bigint [ref: > medicines.id]
  sale_quantity int
  sale_price double
  amount double
  tax double [null]
  created_at timestamp
  updated_at timestamp
  
  Note: 'Medicines sold to patients (over-the-counter)'
}

Table medicine_bills {
  id bigint [pk, increment]
  history_number varchar(255) [unique]
  patient_id int [ref: > patients.id]
  bill_date datetime
  payable_amount double
  tax_amount double [null]
  discount double [null]
  net_amount double
  status boolean [default: 0]
  created_at timestamp
  updated_at timestamp
  
  Note: 'Medicine sales bills/invoices'
}

// Database View (Read-only)
Table used_medicines_view {
  id bigint [pk]
  medicine_id bigint [ref: > medicines.id]
  medicine_name varchar(255)
  quantity int
  source varchar(255)
  patient_name varchar(255)
  nurse_incharged varchar(255) [null]
  used_for varchar(255)
  expiry_date varchar(255) [null]
  created_at timestamp
  
  Note: 'Virtual table: Union view of consultation_medicines and sale_medicines for medicine usage tracking'
}

// ==========================================
// LOCATION & GEOGRAPHY
// ==========================================

Table countries {
  id bigint [pk, increment]
  name varchar(255)
  short_code varchar(255) [null]
  phone_code varchar(255) [null]
  created_at timestamp
  updated_at timestamp
  
  Note: 'Country reference data'
}

Table states {
  id bigint [pk, increment]
  name varchar(255)
  country_id bigint [ref: > countries.id]
  created_at timestamp
  updated_at timestamp
  
  Note: 'State/province reference data'
}

Table cities {
  id bigint [pk, increment]
  name varchar(255)
  state_id bigint [ref: > states.id]
  created_at timestamp
  updated_at timestamp
  
  Note: 'City reference data'
}

Table addresses {
  id bigint [pk, increment]
  owner_type varchar(255)
  owner_id bigint
  address1 varchar(255) [null]
  address2 varchar(255) [null]
  city varchar(255) [null]
  zip varchar(255) [null]
  country_id bigint [ref: > countries.id, null]
  state_id bigint [ref: > states.id, null]
  city_id bigint [ref: > cities.id, null]
  created_at timestamp
  updated_at timestamp
  
  Note: 'Polymorphic address storage for users, doctors, patients'
}

// ==========================================
// MANY-TO-MANY RELATIONSHIP TABLES
// ==========================================

Table doctor_specialization {
  id bigint [pk, increment]
  doctor_id bigint [ref: > doctors.id]
  specialization_id bigint [ref: > specializations.id]
  created_at timestamp
  updated_at timestamp
  
  Note: 'Many-to-many relationship: doctors can have multiple specializations'
}

Table service_doctor {
  id bigint [pk, increment]
  service_id bigint [ref: > services.id]
  doctor_id bigint [ref: > doctors.id]
  
  Note: 'Many-to-many relationship: doctors can provide multiple services'
}

// ==========================================
// PERMISSIONS & ROLES (Spatie)
// ==========================================

Table permissions {
  id bigint [pk, increment]
  name varchar(255) [unique]
  display_name varchar(255) [null]
  guard_name varchar(255)
  created_at timestamp
  updated_at timestamp
  
  Note: 'System permissions (manage_doctors, manage_patients, etc.)'
}

Table roles {
  id bigint [pk, increment]
  name varchar(255) [unique]
  display_name varchar(255) [null]
  guard_name varchar(255)
  created_at timestamp
  updated_at timestamp
  
  Note: 'User roles (clinic_admin, doctor, staff, patient)'
}

Table model_has_permissions {
  permission_id bigint [ref: > permissions.id]
  model_type varchar(255)
  model_id bigint
  
  Note: 'Polymorphic: Direct permissions assigned to models (users)'
  
  indexes {
    (model_id, model_type, permission_id) [pk]
  }
}

Table model_has_roles {
  role_id bigint [ref: > roles.id]
  model_type varchar(255)
  model_id bigint
  
  Note: 'Polymorphic: Roles assigned to models (users)'
  
  indexes {
    (model_id, model_type, role_id) [pk]
  }
}

Table role_has_permissions {
  permission_id bigint [ref: > permissions.id]
  role_id bigint [ref: > roles.id]
  
  Note: 'Permissions assigned to roles'
  
  indexes {
    (permission_id, role_id) [pk]
  }
}

// ==========================================
// FINANCIAL & TRANSACTIONS
// ==========================================

Table transactions {
  id bigint [pk, increment]
  transaction_id varchar(255) [unique]
  appointment_id bigint [ref: > appointments.id]
  amount double
  type int
  status int [default: 0]
  accepted_by bigint [null]
  payment_type int [null]
  meta text [null]
  created_at timestamp
  updated_at timestamp
  
  Note: 'Financial transactions and payment tracking'
}

Table currencies {
  id bigint [pk, increment]
  currency_name varchar(255)
  currency_icon varchar(255)
  currency_code varchar(255)
  created_at timestamp
  updated_at timestamp
  
  Note: 'Supported currencies for payments'
}

Table payment_gateways {
  id bigint [pk, increment]
  payment_gateway_name varchar(255)
  payment_gateway_id int
  created_at timestamp
  updated_at timestamp
  
  Note: 'Payment gateway configurations'
}

// ==========================================
// ACTIVITY TRACKING
// ==========================================

Table activity_logs {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id, null]
  action varchar(255)
  model_type varchar(255) [null]
  model_id bigint [null]
  old_values json [null]
  new_values json [null]
  ip_address varchar(45) [null]
  user_agent text [null]
  created_at timestamp
  updated_at timestamp
  
  Note: 'System activity and audit trail logging'
}

// ==========================================
// ADDITIONAL SYSTEM TABLES
// ==========================================

Table settings {
  id bigint [pk, increment]
  key varchar(255)
  value text [null]
  created_at timestamp
  updated_at timestamp
  
  Note: 'System configuration settings'
}

Table media {
  id bigint [pk, increment]
  model_type varchar(255)
  model_id bigint
  uuid varchar(255) [null]
  collection_name varchar(255)
  name varchar(255)
  file_name varchar(255)
  mime_type varchar(255) [null]
  disk varchar(255)
  conversions_disk varchar(255) [null]
  size bigint
  manipulations json
  custom_properties json
  generated_conversions json
  responsive_images json
  order_column int [null]
  created_at timestamp
  updated_at timestamp
  
  Note: 'File attachments and media storage'
}

Table notifications {
  id char(36) [pk]
  type varchar(255)
  notifiable_type varchar(255)
  notifiable_id bigint
  data text
  read_at timestamp [null]
  created_at timestamp
  updated_at timestamp
  
  Note: 'System notifications for users'
}

Table failed_jobs {
  id bigint [pk, increment]
  uuid varchar(255) [unique]
  connection text
  queue text
  payload longtext
  exception longtext
  failed_at timestamp [default: `CURRENT_TIMESTAMP`]
  
  Note: 'Failed background jobs tracking'
}

Table password_reset_tokens {
  email varchar(255) [pk]
  token varchar(255)
  created_at timestamp [null]
  
  Note: 'Password reset token storage'
}

