yarn.lock
pnpm-lock.yaml

# Environment and configuration files
.env
.env.backup
.phpunit.result.cache
docker-compose.override.yml
Homestead.json
Homestead.yaml

# IDE and editor-specific files
/.idea
/.vscode
.idea

