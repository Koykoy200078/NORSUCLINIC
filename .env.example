# Medical University Clinic - environment template for a private-LAN, HTTP-only deployment.
# Copy to .env, run `php artisan key:generate`, then edit the values marked CHANGE.

APP_NAME="Medical University Clinic"
# "production" turns off debug pages and allows `php artisan config:cache`. It does NOT force
# HTTPS any more (see FORCE_HTTPS below).
APP_ENV=production
APP_KEY=
# Never true on the clinic network: error pages would print source code and data.
APP_DEBUG=false
# CHANGE: the fixed address clinic PCs use to reach the server, e.g. http://192.168.1.50 (with the
# port if not 80). Uploaded logos/media URLs are built from it - if it changes, re-save the logo.
APP_URL=http://localhost

# Leave false: the LAN server speaks plain HTTP. Set true only if TLS is really terminated in front.
FORCE_HTTPS=false
# Must be false for an HTTP-only LAN, otherwise browsers drop the session cookie and login loops.
SESSION_SECURE_COOKIE=false

BCRYPT_ROUNDS=12

# Rotating daily log files (14 days kept), warnings and errors only. Use LOG_LEVEL=debug only while
# diagnosing a problem - debug logs can contain patient data.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# CHANGE: use a dedicated MySQL/MariaDB user with a strong password, not root with a blank password.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=norsu_clinic
DB_USERNAME=root
DB_PASSWORD=
# Strict SQL mode makes the database reject over-long / invalid values instead of silently cutting
# them. Keep true.
DB_STRICT=true
# Storage engine of every NEW table. InnoDB gives foreign keys and transactions even on a server (WAMP) whose
# my.ini defaults to MyISAM. Keep InnoDB.
DB_ENGINE=InnoDB
# The database's time zone: Philippine time, UTC+8 all year (Laravel is set to Asia/Manila in config/app.php). Keep an OFFSET
# like this one: the name "Asia/Manila" fails on a WAMP MySQL, which has no named time zone tables.
DB_TIMEZONE=+08:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
# The app queues nothing; "sync" needs no jobs table.
QUEUE_CONNECTION=sync

# "file" works out of the box. (CACHE_DRIVER=database would need a cache table that is not shipped.)
CACHE_DRIVER=file

# There is no e-mail on this deployment; messages are written to the log instead of being sent.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="clinic@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# The package that adds the toolbar is a development tool; keep it off.
DEBUGBAR_ENABLED=false

SHOW_FOOTER_VERSION=false

# Real-time updates (Laravel Reverb, runs on the clinic server PC; browsers connect to the page's own host, port below).
# - Leave the three REVERB_APP_* values EMPTY: they are derived from this server's own APP_KEY, so there is nothing to invent.
#   (Write your own only if you want to; never reuse example values. Restart Reverb after changing them.)
# - REVERB_HOST is where THIS site reaches Reverb (the same PC, so 127.0.0.1). It is NOT the address the browsers use (they use
#   the address of the page they opened, whatever the PC's address is today) and NOT the address Reverb listens on (all: 0.0.0.0).
# - With BROADCAST_DRIVER=null the pages still work: they show "Live updates off" and refresh every minute.
# - Something wrong? php artisan realtime:check says which link is broken (the startup script runs it too).
BROADCAST_DRIVER=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
